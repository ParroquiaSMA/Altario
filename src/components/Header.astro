---
import { getSiteConfig } from '../lib/supabase';

interface Props {
  currentPage?: string;
}

const { currentPage = '' } = Astro.props;
const siteConfig = await getSiteConfig();
const { parroquia, apariencia } = siteConfig;

function getAutoInitials(name?: string): string {
  if (!name) return 'AM';
  const clean = name.replace(/^parroquia\s+(de\s+(la\s+)?)?/i, '').trim();
  const words = clean.split(/\s+/).filter(Boolean);
  if (words.length >= 2) {
    return (words[0][0] + words[1][0]).toUpperCase();
  }
  return clean.slice(0, 2).toUpperCase() || 'AM';
}

const initials = parroquia.logo_iniciales || getAutoInitials(parroquia.nombre);
---

<header class="cabecera">
  <div class="contenedor cabecera__fila">
    <a class="marca" href="/">
      {parroquia.logo_url ? (
        <img
          src={parroquia.logo_url}
          alt={parroquia.nombre}
          class="marca__logo"
          loading="eager"
        />
      ) : (
        <>
          <svg width="44" height="44" viewBox="0 0 44 44" role="img" aria-label={`Escudo de ${parroquia.nombre}`}>
            <circle cx="22" cy="22" r="20.5" fill="none" stroke={apariencia.color_acento || '#7A5C24'}></circle>
            <circle cx="22" cy="22" r="17" fill={apariencia.color_primario || '#22366B'}></circle>
            <text x="22" y="28.5" text-anchor="middle" fill={apariencia.color_acento || '#C9A96A'} font-family="Marcellus, Georgia, serif" font-size="16">
              {initials}
            </text>
          </svg>
          <span class="marca__texto">
            <strong class="marca__nombre">{parroquia.nombre}</strong>
            <span class="marca__bajada">Parroquia</span>
          </span>
        </>
      )}
    </a>
    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="nav-principal">Menú</button>
    <nav class="nav" id="nav-principal" aria-label="Navegación principal">
      <a href="/" aria-current={currentPage === 'inicio' ? 'page' : undefined}>Inicio</a>
      <a href="/#horarios">Horarios</a>
      <a href="/sacramentos" aria-current={currentPage === 'sacramentos' ? 'page' : undefined}>Sacramentos</a>
      <a href="/comunidad" aria-current={currentPage === 'comunidad' ? 'page' : undefined}>Comunidad</a>
      <a href="/historia" aria-current={currentPage === 'historia' ? 'page' : undefined}>Historia</a>
      <a href="/galeria" aria-current={currentPage === 'galeria' ? 'page' : undefined}>Galería</a>
      <a href="/donaciones" aria-current={currentPage === 'donaciones' ? 'page' : undefined}>Donaciones</a>
      <a class="boton boton--oro" href="/contacto">Contacto</a>
    </nav>
  </div>
</header>

<style>
  .marca__logo {
    height: 42px !important;
    max-height: 42px !important;
    width: auto !important;
    max-width: 220px !important;
    object-fit: contain !important;
    display: block !important;
  }
</style>

<script is:inline>
  (() => {
    const cabecera = document.querySelector('.cabecera');
    const btn = document.querySelector('.menu-btn');
    const nav = document.getElementById('nav-principal');

    if (cabecera) {
      const onScroll = () => {
        const scrolled = window.scrollY > 20;
        cabecera.classList.toggle('cabecera--scrolled', scrolled);
      };
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();
    }

    if (btn && nav && !btn.dataset.menuReady) {
      btn.dataset.menuReady = 'true';

      const toggleMenu = (forzarEstado) => {
        const abiertoActual = nav.getAttribute('data-abierto') === 'true';
        const nuevoEstado = typeof forzarEstado === 'boolean' ? forzarEstado : !abiertoActual;
        nav.setAttribute('data-abierto', String(nuevoEstado));
        btn.setAttribute('aria-expanded', String(nuevoEstado));
        if (cabecera) {
          cabecera.classList.toggle('cabecera--abierta', nuevoEstado);
        }
      };

      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        toggleMenu();
      });

      nav.addEventListener('click', (e) => {
        if (e.target.closest('a') && window.innerWidth <= 1000) {
          toggleMenu(false);
        }
      });

      document.addEventListener('click', (e) => {
        if (!nav.contains(e.target) && !btn.contains(e.target)) {
          toggleMenu(false);
        }
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          toggleMenu(false);
          btn.focus();
        }
      });
    }
  })();
</script>

---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getSiteConfig } from '../lib/supabase';

interface Props {
  title?: string;
  description?: string;
  currentPage?: string;
}

const siteConfig = await getSiteConfig();
const { parroquia, apariencia, dominio } = siteConfig;

const {
  title = `${parroquia.nombre} — Horarios de misa y sacramentos`,
  description = `Horarios de misa y confesión, sacramentos, grupos, historia y contacto de la ${parroquia.nombre}.`,
  currentPage = '',
} = Astro.props;

const canonicalUrl = dominio?.dominio_web ? `https://${dominio.dominio_web}${Astro.url.pathname}` : undefined;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content={apariencia?.color_fondo_hero || "#16244A"} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}

    {dominio?.google_search_console_id && (
      <meta name="google-site-verification" content={dominio.google_search_console_id} />
    )}

    {dominio?.google_analytics_id && (
      <>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${dominio.google_analytics_id}`}></script>
        <script is:inline define:vars={{ gaId: dominio.google_analytics_id }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', gaId);
        </script>
      </>
    )}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Marcellus&family=Alegreya+Sans:ital,wght@0,400;0,500;0,700;1,400&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/assets/estilos.css" />

    {/* Dynamic theme colors configured from CMS */}
    <style define:vars={{
      colorLapis: apariencia?.color_fondo_hero || '#16244A',
      colorLapisClaro: apariencia?.color_primario || '#22366B',
      colorOro: apariencia?.color_acento || '#C9A96A',
    }}>
      :root {
        --lapis: var(--colorLapis);
        --lapis-claro: var(--colorLapisClaro);
        --oro: var(--colorOro);
        --oro-texto: var(--colorOro);
      }
      .cabecera {
        background-color: var(--colorLapis) !important;
      }
      .hero, .portada, .seccion--oscura, .pie {
        background-color: var(--colorLapis) !important;
      }
      .hero__fondo g, .portada__fondo g {
        stroke: var(--colorOro) !important;
      }
      .boton--oro, .pildora--oro {
        background-color: var(--colorOro) !important;
        color: var(--colorLapis) !important;
        border-color: var(--colorOro) !important;
      }
      .boton--linea {
        border-color: var(--colorOro) !important;
        color: #FFFFFF !important;
      }
      .horarios caption, .proxima__rotulo, .antetitulo {
        color: var(--colorOro) !important;
      }
      .seccion--oscura .antetitulo {
        color: var(--colorOro) !important;
      }
      a {
        color: var(--colorLapisClaro);
      }
    </style>
  </head>
  <body>
    <a class="saltar" href="#principal">Ir al contenido</a>

    <Header currentPage={currentPage} />

    <main id="principal">
      <slot />
    </main>

    <Footer />

    <script is:inline src="/assets/parroquia.js"></script>
  </body>
</html>

---
import Layout from '../layouts/Layout.astro';
import { getSiteConfig, getSacramentos } from '../lib/supabase';

const siteConfig = await getSiteConfig();
const { parroquia } = siteConfig;
const sacramentos = await getSacramentos();
---

<Layout title={`Sacramentos — ${parroquia.nombre}`} currentPage="sacramentos">
  <section class="portada">
    <svg class="portada__fondo" viewBox="0 0 1200 300" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
      <g fill="none" stroke="#C9A96A">
        <circle cx="980" cy="150" r="60"></circle><circle cx="980" cy="150" r="110"></circle>
        <circle cx="980" cy="150" r="160"></circle><circle cx="980" cy="150" r="215"></circle>
        <path d="M980 -70 V370 M760 150 H1200"></path>
        <path d="M825 -5 L1135 305 M1135 -5 L825 305"></path>
        <path d="M200 300 V170 a60 60 0 0 1 120 0 V300"></path>
      </g>
    </svg>
    <div class="contenedor">
      <p class="miga"><a href="/">Inicio</a><span aria-hidden="true">›</span>Sacramentos</p>
      <p class="antetitulo">Sacramentos y trámites</p>
      <h1>Cada preparación tiene sus tiempos</h1>
      <p class="portada__bajada">
        Todo empieza igual: pasás por la secretaría, se anota tu caso y te decimos la fecha más cercana.
        Cuanto antes vengas, más tranquilo se organiza todo.
      </p>
    </div>
  </section>

  <section class="seccion">
    <div class="contenedor">
      <div class="rejilla">
        {sacramentos.map((s) => (
          <article class="tarjeta" data-tipo={s.categoria || "sacramento"}>
            <h3>{s.titulo}</h3>
            <p>{s.descripcion}</p>
            {s.requisitos && (
              <p class="tarjeta__requisito">
                <strong>Detalles y requisitos:</strong> {s.requisitos}
              </p>
            )}
          </article>
        ))}
      </div>

      <div class="ficha" style="margin-top:2.5rem">
        <h3>¿Buscás una partida o certificado de años anteriores?</h3>
        <p>
          Los libros parroquiales de bautismos, matrimonios y confirmaciones se conservan en nuestra secretaría.
          Para solicitar una copia o constancia para otro trámite o diócesis, acercate en los horarios de atención (martes a viernes de 16:00 a 18:00 hs)
          con la fecha aproximada y el nombre completo.
        </p>
      </div>
    </div>
  </section>
</Layout>

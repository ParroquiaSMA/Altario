---
import Layout from '../layouts/Layout.astro';
import FondoDecorativo from '../components/FondoDecorativo.astro';
import { getGrupos, getSiteConfig } from '../lib/supabase';

const siteConfig = await getSiteConfig();
const grupos = await getGrupos();
const { parroquia, parroco } = siteConfig;
---

<Layout title={`Comunidad — ${parroquia.nombre}`} currentPage="comunidad">
  <section class="portada">
    <FondoDecorativo />
    <div class="contenedor">
      <p class="miga"><a href="/">Inicio</a><span aria-hidden="true">›</span>Comunidad</p>
      <p class="antetitulo">Vida parroquial</p>
      <h1>Grupos que te esperan</h1>
      <p class="portada__bajada">
        No hace falta anotarse ni avisar: casi todos los grupos reciben gente nueva en cualquier momento del año.
        Caé un día y mirá cómo es.
      </p>
    </div>
  </section>

  <section class="seccion">
    <div class="contenedor">
      <div class="rejilla">
        {grupos.map((g) => (
          <article class="tarjeta">
            <h3>{g.nombre}</h3>
            <p>{g.descripcion}</p>
            {g.horario_encuentro && <p class="tarjeta__requisito">{g.horario_encuentro}</p>}
          </article>
        ))}
      </div>
    </div>
  </section>

  {parroco.nombre && (
    <section class="seccion seccion--papel">
      <div class="contenedor--angosto">
        <div class={`parroco-ficha ${parroco.foto_url ? 'parroco-ficha--con-foto' : ''}`}>
          {parroco.foto_url && (
            <div class="parroco-ficha__foto-wrap">
              <img
                src={parroco.foto_url}
                alt={`Fotografía de ${parroco.nombre}`}
                class="parroco-ficha__foto"
                loading="lazy"
              />
            </div>
          )}
          <div class="parroco-ficha__contenido">
            <p class="antetitulo">Atención pastoral</p>
            <h2>{parroco.nombre}</h2>
            <p class="divisor"><i aria-hidden="true"></i></p>
            <div class="prosa">
              <p><strong>{parroco.titulo || 'Párroco'}</strong></p>
              {parroco.biografia && <p>{parroco.biografia}</p>}
              <p>Si querés hablar con el sacerdote para una dirección espiritual o confesión, podés escribirnos o acercarte después de misa.</p>
              {(parroco.telefono || parroco.email) && (
                <ul class="parroco-contacto">
                  {parroco.telefono && (
                    <li>
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                      <a href={`tel:${parroco.telefono.replace(/[^0-9+]/g, '')}`}>{parroco.telefono}</a>
                    </li>
                  )}
                  {parroco.email && (
                    <li>
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                      <a href={`mailto:${parroco.email}`}>{parroco.email}</a>
                    </li>
                  )}
                </ul>
              )}
            </div>
          </div>
        </div>
      </div>
    </section>
  )}

  <section class="franja">
    <div class="contenedor franja__fila">
      <div>
        <h2>¿No sabés por dónde empezar?</h2>
        <p>Contanos qué te gustaría hacer y cuánto tiempo tenés, y te decimos qué grupo te queda bien.</p>
      </div>
      <a class="boton boton--azul" href="/contacto">Escribinos</a>
    </div>
  </section>
</Layout>

<style>
  .parroco-ficha--con-foto {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 2.5rem;
    align-items: start;
  }

  .parroco-ficha__foto-wrap {
    width: 200px;
    height: 200px;
    border-radius: var(--radio, 6px);
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
    border: 1px solid var(--linea);
    background: var(--base);
    flex-shrink: 0;
  }

  .parroco-ficha__foto {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .parroco-contacto {
    list-style: none;
    padding: 0;
    margin: 1.25rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
  }

  .parroco-contacto li {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9375rem;
  }

  .parroco-contacto svg {
    color: var(--oro-texto);
    flex-shrink: 0;
  }

  .parroco-contacto a {
    color: var(--lapis);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .parroco-contacto a:hover {
    color: var(--azul);
  }

  @media (max-width: 640px) {
    .parroco-ficha--con-foto {
      grid-template-columns: 1fr;
      gap: 1.75rem;
      text-align: center;
    }

    .parroco-ficha__foto-wrap {
      margin-inline: auto;
      width: 160px;
      height: 160px;
    }

    .parroco-ficha--con-foto .divisor {
      justify-content: center;
    }

    .parroco-contacto {
      justify-content: center;
    }
  }
</style>

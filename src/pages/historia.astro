---
import Layout from '../layouts/Layout.astro';
import { getSiteConfig } from '../lib/supabase';
import { marked } from 'marked';

const siteConfig = await getSiteConfig();
const { parroquia, historia } = siteConfig;

const titulo = historia?.titulo || 'Setenta y ocho años en la misma esquina';
const bajada = historia?.bajada || 'Empezó como una capilla de chapa levantada por vecinos que no querían caminar treinta cuadras para ir a misa. El templo de hoy se construyó alrededor de esa capilla, sin tirarla abajo.';

const markdownContent = historia?.contenido_markdown || '';
const contenidoHtml = markdownContent ? await marked.parse(markdownContent) : '';
---

<Layout title={`Historia — ${parroquia.nombre}`} description={bajada} currentPage="historia">
  <section class="portada">
    <svg class="portada__fondo" viewBox="0 0 1200 300" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
      <g fill="none" stroke="#C9A96A">
        <path d="M100 300 V150 a70 70 0 0 1 140 0 V300"></path>
        <path d="M300 300 V120 a90 90 0 0 1 180 0 V300"></path>
        <path d="M540 300 V150 a70 70 0 0 1 140 0 V300"></path>
        <path d="M740 300 V120 a90 90 0 0 1 180 0 V300"></path>
        <path d="M980 300 V150 a70 70 0 0 1 140 0 V300"></path>
      </g>
    </svg>
    <div class="contenedor">
      <p class="miga"><a href="/">Inicio</a><span aria-hidden="true">›</span>Historia</p>
      <p class="antetitulo">Historia</p>
      <h1>{titulo}</h1>
      {bajada && <p class="portada__bajada">{bajada}</p>}
    </div>
  </section>

  <section class="seccion">
    <div class="contenedor--angosto">
      <article class="prosa" set:html={contenidoHtml}>
      </article>
    </div>
  </section>
</Layout>

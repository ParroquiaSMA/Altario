<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 900 675" width="900" height="675">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#1b2a52"/><stop offset="100%" stop-color="#0c1324"/>
    </linearGradient>
    <radialGradient id="glow" cx="50%" cy="45%" r="60%">
      <stop offset="0%" stop-color="#C9A96A" stop-opacity="0.35"/>
      <stop offset="100%" stop-color="#16244A" stop-opacity="0"/>
    </radialGradient>
    <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
      <path d="M 40 0 L 0 0 0 40" fill="none" stroke="#C9A96A" stroke-width="0.75" stroke-opacity="0.12"/>
    </pattern>
  </defs>

  <!-- Background -->
  <rect width="900" height="675" fill="url(#bg)"/>
  <rect width="900" height="675" fill="url(#grid)"/>
  <circle cx="450" cy="300" r="320" fill="url(#glow)"/>

  <!-- Decorative Frame -->
  <rect x="25" y="25" width="850" height="625" rx="8" fill="none" stroke="#C9A96A" stroke-opacity="0.3" stroke-width="2"/>
  <rect x="35" y="35" width="830" height="605" rx="6" fill="none" stroke="#C9A96A" stroke-opacity="0.15" stroke-width="1"/>

  <!-- Corner Ornaments -->
  <path d="M 45 65 L 65 45 M 45 45 L 75 45 M 45 45 L 45 75" stroke="#C9A96A" stroke-width="2" fill="none" opacity="0.6"/>
  <path d="M 855 65 L 835 45 M 855 45 L 825 45 M 855 45 L 855 75" stroke="#C9A96A" stroke-width="2" fill="none" opacity="0.6"/>
  <path d="M 45 610 L 65 630 M 45 630 L 75 630 M 45 630 L 45 600" stroke="#C9A96A" stroke-width="2" fill="none" opacity="0.6"/>
  <path d="M 855 610 L 835 630 M 855 630 L 825 630 M 855 630 L 855 600" stroke="#C9A96A" stroke-width="2" fill="none" opacity="0.6"/>

  <!-- Central Visual Symbol & Motif -->
  <path d="M 350 400 L 450 140 L 550 400 Z" fill="none" stroke="#C9A96A" stroke-width="1.5" opacity="0.25"/>

  <g transform="translate(450, 260)">
    <circle cx="0" cy="0" r="65" fill="#16244A" stroke="#C9A96A" stroke-width="2.5" opacity="0.9"/>
    <circle cx="0" cy="0" r="55" fill="none" stroke="#C9A96A" stroke-width="1" stroke-dasharray="4 4" opacity="0.6"/>
    <text x="0" y="16" text-anchor="middle" font-size="44" fill="#C9A96A">⛪</text>
  </g>

  <!-- Title & Caption -->
  <text x="450" y="440" text-anchor="middle" fill="#FFFFFF" font-family="Georgia, serif" font-size="34" font-weight="bold" letter-spacing="1">
    Campanario Parroquial
  </text>
  <text x="450" y="480" text-anchor="middle" fill="#C9A96A" font-family="'Segoe UI', Roboto, sans-serif" font-size="19" letter-spacing="2" text-transform="uppercase">
    Vista Exterior
  </text>
  <text x="450" y="525" text-anchor="middle" fill="#98A2B8" font-family="'Segoe UI', Roboto, sans-serif" font-size="15">
    Parroquia Santa María de la Ayuda
  </text>
</svg>
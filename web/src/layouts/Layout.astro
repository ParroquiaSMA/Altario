---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  currentPage?: string;
}

const {
  title = 'Parroquia Santa María de la Ayuda — Horarios de misa y sacramentos',
  description = 'Horarios de misa y confesión, sacramentos, grupos, historia y contacto de la Parroquia Santa María de la Ayuda.',
  currentPage = '',
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#16244A" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Marcellus&family=Alegreya+Sans:ital,wght@0,400;0,500;0,700;1,400&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/assets/estilos.css" />
  </head>
  <body>
    <a class="saltar" href="#principal">Ir al contenido</a>

    <Header currentPage={currentPage} />

    <main id="principal">
      <slot />
    </main>

    <Footer />

    <script is:inline src="/assets/parroquia.js"></script>
  </body>
</html>

---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Analytics from '@vercel/analytics/astro';
import { getSiteConfig } from '../lib/supabase';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  currentPage?: string;
}

const siteConfig = await getSiteConfig();
const { parroquia, apariencia, dominio, seo } = siteConfig;

const {
  title = seo?.titulo_sitio || `${parroquia.nombre} — Horarios de misa y sacramentos`,
  description = seo?.descripcion || `Horarios de misa y confesión, sacramentos, grupos, historia y contacto de la ${parroquia.nombre}.`,
  currentPage = '',
} = Astro.props;

const canonicalUrl = dominio?.dominio_web ? `https://${dominio.dominio_web}${Astro.url.pathname}` : undefined;
const faviconUrl = seo?.favicon_url || parroquia.logo_url || '/favicon.ico';
const ogImageUrl = seo?.og_image_url || parroquia.logo_url || undefined;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {seo?.palabras_clave && <meta name="keywords" content={seo.palabras_clave} />}
    <meta name="theme-color" content={apariencia?.color_fondo_hero || "#16244A"} />
    
    <!-- Favicon dinámico -->
    <link rel="icon" href={faviconUrl} />
    <link rel="apple-touch-icon" href={faviconUrl} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}

    <!-- Open Graph / Redes Sociales (WhatsApp, Facebook) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={parroquia.nombre} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl || Astro.url.href} />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}

    {dominio?.google_search_console_id && (
      <meta name="google-site-verification" content={dominio.google_search_console_id} />
    )}

    {dominio?.google_analytics_id && (
      <>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${dominio.google_analytics_id}`}></script>
        <script is:inline define:vars={{ gaId: dominio.google_analytics_id }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', gaId);
        </script>
      </>
    )}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Marcellus&family=Alegreya+Sans:ital,wght@0,400;0,500;0,700;1,400&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/assets/estilos.css?v=20260917b" />

    {/* Dynamic theme colors configured from CMS */}
    <style define:vars={{
      colorLapis: apariencia?.color_fondo_hero || '#111111',
      colorLapisClaro: apariencia?.color_primario || '#229ED9',
      colorOro: apariencia?.color_acento || '#C9A96A',
    }}>
      :root {
        --lapis: var(--colorLapis);
        --lapis-claro: var(--colorLapisClaro);
        --oro: var(--colorOro);
        --oro-texto: var(--colorOro);
      }
      .cabecera {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        width: 100%;
        z-index: 100;
        transition: background-color 0.28s ease, border-color 0.28s ease, box-shadow 0.28s ease, backdrop-filter 0.28s ease;
      }
      .cabecera:not(.cabecera--scrolled) {
        background-color: transparent !important;
        background: transparent !important;
        border-bottom-color: transparent !important;
        box-shadow: none !important;
        backdrop-filter: none !important;
      }
      .cabecera:not(.cabecera--scrolled).cabecera--abierta,
      .cabecera:not(.cabecera--scrolled):has(.nav[data-abierto="true"]) {
        background-color: var(--colorLapis, #16244A) !important;
        background: var(--colorLapis, #16244A) !important;
        box-shadow: 0 12px 28px rgba(0, 0, 0, 0.25) !important;
      }
      .cabecera.cabecera--scrolled {
        background-color: rgba(255, 255, 255, 0.96) !important;
        background: rgba(255, 255, 255, 0.96) !important;
        backdrop-filter: blur(14px) saturate(160%) !important;
        border-bottom: 1px solid var(--linea, #E6E3DC) !important;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08) !important;
      }
      .hero, .portada, .seccion--oscura, .pie {
        background-color: var(--colorLapis) !important;
      }
      .hero__fondo g, .portada__fondo g {
        stroke: var(--colorOro, #C9A96A) !important;
      }
      @media (max-width: 768px) {
        .hero__fondo {
          opacity: 0.07 !important;
        }
        .portada__fondo {
          opacity: 0.09 !important;
        }
        .hero__fondo g, .portada__fondo g {
          stroke: #FFFFFF !important;
          stroke-width: 0.95px !important;
        }
      }
      .boton--oro, .pildora--oro {
        background-color: var(--colorOro) !important;
        color: var(--colorLapis) !important;
        border-color: var(--colorOro) !important;
      }
      .boton--linea {
        border-color: var(--colorOro) !important;
        color: #FFFFFF !important;
      }
      .horarios caption, .proxima__rotulo, .antetitulo {
        color: var(--colorOro) !important;
      }
      .seccion--oscura .antetitulo {
        color: var(--colorOro) !important;
      }
      a {
        color: var(--colorLapisClaro);
      }
      .proxima__pie a {
        color: #FFFFFF !important;
        text-decoration: underline;
        text-underline-offset: 3px;
      }
      .proxima__pie a:hover {
        color: var(--colorOro) !important;
      }
    </style>
  </head>
  <body>
    <a class="saltar" href="#principal">Ir al contenido</a>

    <Header currentPage={currentPage} />

    <main id="principal">
      <slot />
    </main>

    <Footer />

    <script is:inline src="/assets/parroquia.js"></script>
    <Analytics />
  </body>
</html>

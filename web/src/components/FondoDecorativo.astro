---
interface Props {
  variant?: 'hero' | 'portada';
  class?: string;
}

const { variant, class: customClass } = Astro.props;

const isHero = variant === 'hero' || (customClass && customClass.includes('hero'));
const className = customClass || (isHero ? 'hero__fondo' : 'portada__fondo');
const viewBox = isHero ? '0 0 1200 620' : '0 0 1200 300';
const cx = isHero ? 960 : 980;
const cy = isHero ? 250 : 150;
---

<svg
  class={className}
  viewBox={viewBox}
  width="100%"
  height="100%"
  preserveAspectRatio="xMaxYMid slice"
  aria-hidden="true"
  focusable="false"
>
  <g fill="none" stroke="#C9A96A" stroke-width="1.1" stroke-linecap="round">
    <!-- Aureola con rayos de la custodia -->
    <g transform={`translate(${cx}, ${cy})`}>
      <circle cx="0" cy="0" r="64.5"/>
      <circle cx="0" cy="0" r="77.4"/>
      <line x1="86" y1="0" x2="215" y2="0"/>
      <line x1="85.3" y1="11.2" x2="157.7" y2="20.8"/>
      <line x1="83.1" y1="22.3" x2="207.7" y2="55.6"/>
      <line x1="79.5" y1="32.9" x2="147" y2="60.9"/>
      <line x1="74.5" y1="43" x2="186.2" y2="107.5"/>
      <line x1="68.2" y1="52.4" x2="126.2" y2="96.9"/>
      <line x1="60.8" y1="60.8" x2="152" y2="152"/>
      <line x1="52.4" y1="68.2" x2="96.9" y2="126.2"/>
      <line x1="43" y1="74.5" x2="107.5" y2="186.2"/>
      <line x1="32.9" y1="79.5" x2="60.9" y2="147"/>
      <line x1="22.3" y1="83.1" x2="55.6" y2="207.7"/>
      <line x1="11.2" y1="85.3" x2="20.8" y2="157.7"/>
      <line x1="0" y1="86" x2="0" y2="215"/>
      <line x1="-11.2" y1="85.3" x2="-20.8" y2="157.7"/>
      <line x1="-22.3" y1="83.1" x2="-55.6" y2="207.7"/>
      <line x1="-32.9" y1="79.5" x2="-60.9" y2="147"/>
      <line x1="-43" y1="74.5" x2="-107.5" y2="186.2"/>
      <line x1="-52.4" y1="68.2" x2="-96.9" y2="126.2"/>
      <line x1="-60.8" y1="60.8" x2="-152" y2="152"/>
      <line x1="-68.2" y1="52.4" x2="-126.2" y2="96.9"/>
      <line x1="-74.5" y1="43" x2="-186.2" y2="107.5"/>
      <line x1="-79.5" y1="32.9" x2="-147" y2="60.9"/>
      <line x1="-83.1" y1="22.3" x2="-207.7" y2="55.6"/>
      <line x1="-85.3" y1="11.2" x2="-157.7" y2="20.8"/>
      <line x1="-86" y1="0" x2="-215" y2="0"/>
      <line x1="-85.3" y1="-11.2" x2="-157.7" y2="-20.8"/>
      <line x1="-83.1" y1="-22.3" x2="-207.7" y2="-55.6"/>
      <line x1="-79.5" y1="-32.9" x2="-147" y2="-60.9"/>
      <line x1="-74.5" y1="-43" x2="-186.2" y2="-107.5"/>
      <line x1="-68.2" y1="-52.4" x2="-126.2" y2="-96.9"/>
      <line x1="-60.8" y1="-60.8" x2="-152" y2="-152"/>
      <line x1="-52.4" y1="-68.2" x2="-96.9" y2="-126.2"/>
      <line x1="-43" y1="-74.5" x2="-107.5" y2="-186.2"/>
      <line x1="-32.9" y1="-79.5" x2="-60.9" y2="-147"/>
      <line x1="-22.3" y1="-83.1" x2="-55.6" y2="-207.7"/>
      <line x1="-11.2" y1="-85.3" x2="-20.8" y2="-157.7"/>
      <line x1="0" y1="-86" x2="0" y2="-215"/>
      <line x1="11.2" y1="-85.3" x2="20.8" y2="-157.7"/>
      <line x1="22.3" y1="-83.1" x2="55.6" y2="-207.7"/>
      <line x1="32.9" y1="-79.5" x2="60.9" y2="-147"/>
      <line x1="43" y1="-74.5" x2="107.5" y2="-186.2"/>
      <line x1="52.4" y1="-68.2" x2="96.9" y2="-126.2"/>
      <line x1="60.8" y1="-60.8" x2="152" y2="-152"/>
      <line x1="68.2" y1="-52.4" x2="126.2" y2="-96.9"/>
      <line x1="74.5" y1="-43" x2="186.2" y2="-107.5"/>
      <line x1="79.5" y1="-32.9" x2="147" y2="-60.9"/>
      <line x1="83.1" y1="-22.3" x2="207.7" y2="-55.6"/>
      <line x1="85.3" y1="-11.2" x2="157.7" y2="-20.8"/>
    </g>

    <!-- Arco arquitectónico izquierdo -->
    {isHero ? (
      <path d="M200 620 V350 a60 60 0 0 1 120 0 V620" />
    ) : (
      <path d="M200 300 V170 a60 60 0 0 1 120 0 V300" />
    )}
  </g>
</svg>

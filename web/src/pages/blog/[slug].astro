---
import Layout from '../../layouts/Layout.astro';
import FondoDecorativo from '../../components/FondoDecorativo.astro';
import { getSiteConfig, getBlogPosts, getBlogPostBySlug } from '../../lib/supabase';
const { slug } = Astro.params;
const siteConfig = await getSiteConfig();
const { parroquia } = siteConfig;

const post = await getBlogPostBySlug(slug!);
if (!post) return Astro.redirect('/blog');

const allPosts = await getBlogPosts();
const otherPosts = allPosts.filter(p => p.slug !== slug).slice(0, 3);

function formatFecha(fecha?: string | null): string {
  if (!fecha) return '';
  try {
    const parts = fecha.split('-');
    if (parts.length === 3) {
      const d = new Date(parseInt(parts[0]), parseInt(parts[1]) - 1, parseInt(parts[2]));
      return d.toLocaleDateString('es-UY', { day: 'numeric', month: 'long', year: 'numeric' });
    }
  } catch {}
  return fecha;
}

import { marked } from 'marked';

// Render markdown or rich HTML content
function renderContenido(text: string): string {
  if (!text) return '';
  if (/<[a-z][\s\S]*>/i.test(text)) {
    return text;
  }
  try {
    return marked.parse(text) as string;
  } catch {
    return text;
  }
}
---

<Layout
  title={`${post.titulo} — ${parroquia.nombre}`}
  description={post.extracto}
  currentPage="blog"
>
  <section class="portada">
    <FondoDecorativo />
    <div class="contenedor">
      <p class="miga">
        <a href="/">Inicio</a><span aria-hidden="true">›</span>
        <a href="/blog">Blog</a><span aria-hidden="true">›</span>
        {post.titulo}
      </p>
      <p class="antetitulo">
        {post.categoria && post.categoria !== 'general' ? post.categoria : 'Blog'}
      </p>
      <h1>{post.titulo}</h1>
      <p class="portada__bajada">
        {post.fecha_publicacion && (
          <time datetime={post.fecha_publicacion}>{formatFecha(post.fecha_publicacion)}</time>
        )}
        {post.autor && ` · ${post.autor}`}
      </p>
    </div>
  </section>

  <section class="seccion">
    <div class="contenedor--angosto">
      {post.imagen_url && (
        <figure class="blog-hero">
          <img
            src={post.imagen_url}
            alt={post.titulo}
            width="900"
            height="500"
            loading="eager"
          />
        </figure>
      )}

      <div class="prosa" set:html={renderContenido(post.contenido)} />

      <div class="blog-compartir">
        <p class="blog-compartir__label">Compartir esta nota</p>
        <div class="blog-compartir__botones">
          <a
            href={`https://wa.me/?text=${encodeURIComponent(post.titulo + ' — ' + parroquia.nombre)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="boton boton--azul boton--chico"
          >
            WhatsApp
          </a>
          <a
            href={`https://www.facebook.com/sharer/sharer.php?quote=${encodeURIComponent(post.titulo)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="boton boton--linea boton--chico"
          >
            Facebook
          </a>
        </div>
      </div>
    </div>
  </section>

  {otherPosts.length > 0 && (
    <section class="seccion seccion--papel">
      <div class="contenedor">
        <p class="antetitulo">Seguí leyendo</p>
        <h2>Otras notas</h2>
        <p class="divisor"><i aria-hidden="true"></i></p>

        <div class="blog-grid">
          {otherPosts.map((p) => (
            <a href={`/blog/${p.slug}`} class="blog-card">
              {p.imagen_url && (
                <div class="blog-card__imagen">
                  <img
                    src={p.imagen_url}
                    alt={p.titulo}
                    width="600"
                    height="340"
                    loading="lazy"
                  />
                </div>
              )}
              <div class="blog-card__cuerpo">
                <div class="blog-card__meta">
                  {p.fecha_publicacion && (
                    <time datetime={p.fecha_publicacion}>{formatFecha(p.fecha_publicacion)}</time>
                  )}
                </div>
                <h2 class="blog-card__titulo">{p.titulo}</h2>
                <p class="blog-card__extracto">{p.extracto}</p>
                <span class="blog-card__leer">Leer más →</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="franja">
    <div class="contenedor franja__fila">
      <div>
        <h2>Más del blog</h2>
        <p>Conocé todas las novedades de la comunidad.</p>
      </div>
      <a class="boton boton--azul" href="/blog">Ver todas las notas</a>
    </div>
  </section>
</Layout>

<style>
  .blog-hero {
    margin: 0 0 2.5rem;
    border-radius: var(--radio);
    overflow: hidden;
  }
  .blog-hero img {
    width: 100%;
    height: auto;
    display: block;
    aspect-ratio: 16/9;
    object-fit: cover;
  }

  .blog-compartir {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--linea);
  }
  .blog-compartir__label {
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--gris);
    margin-bottom: 0.75rem;
  }
  .blog-compartir__botones {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
  .boton--chico {
    font-size: 0.8125rem;
    padding: 0.45em 1.2em;
  }

  /* Cards grid — also used in blog/index.astro so keep in sync */
  .blog-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr));
    gap: 2rem;
  }

  .blog-card {
    display: flex;
    flex-direction: column;
    background: var(--papel);
    border: 1px solid var(--linea);
    border-radius: var(--radio);
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: box-shadow 0.25s ease, transform 0.25s ease;
  }
  .blog-card:hover {
    box-shadow: 0 8px 28px rgba(0,0,0,0.09);
    transform: translateY(-3px);
  }

  .blog-card__imagen {
    aspect-ratio: 16/9;
    overflow: hidden;
  }
  .blog-card__imagen img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.35s ease;
  }
  .blog-card:hover .blog-card__imagen img {
    transform: scale(1.04);
  }

  .blog-card__cuerpo {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .blog-card__meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.8125rem;
    color: var(--gris);
    margin-bottom: 0.625rem;
  }

  .blog-card__titulo {
    font-family: var(--display);
    font-size: clamp(1.15rem, 2.5vw, 1.35rem);
    line-height: 1.3;
    margin: 0 0 0.5rem;
    color: var(--tinta);
  }

  .blog-card__extracto {
    color: var(--gris-cuerpo);
    font-size: 0.9375rem;
    line-height: 1.6;
    margin: 0 0 1rem;
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .blog-card__leer {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--lapis-claro);
    transition: color 0.2s ease;
  }
  .blog-card:hover .blog-card__leer {
    color: var(--oro-texto);
  }
</style>

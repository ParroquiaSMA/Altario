---
import Layout from '../../layouts/Layout.astro';
import FondoDecorativo from '../../components/FondoDecorativo.astro';
import { getSiteConfig, getBlogPosts } from '../../lib/supabase';

const siteConfig = await getSiteConfig();
const { parroquia } = siteConfig;
const posts = await getBlogPosts();

function formatFecha(fecha?: string | null): string {
  if (!fecha) return '';
  try {
    const parts = fecha.split('-');
    if (parts.length === 3) {
      const d = new Date(parseInt(parts[0]), parseInt(parts[1]) - 1, parseInt(parts[2]));
      return d.toLocaleDateString('es-UY', { day: 'numeric', month: 'long', year: 'numeric' });
    }
  } catch {}
  return fecha;
}
---

<Layout
  title={`Blog — ${parroquia.nombre}`}
  description="Novedades, reflexiones y crónicas de la vida parroquial."
  currentPage="blog"
>
  <section class="portada">
    <FondoDecorativo />
    <div class="contenedor">
      <p class="miga"><a href="/">Inicio</a><span aria-hidden="true">›</span>Blog</p>
      <p class="antetitulo">Novedades</p>
      <h1>Blog de la parroquia</h1>
      <p class="portada__bajada">
        Crónicas, reflexiones y noticias de nuestra comunidad.
      </p>
    </div>
  </section>

  <section class="seccion">
    <div class="contenedor">
      {posts.length > 0 ? (
        <div class="blog-grid">
          {posts.map((post) => (
            <a href={`/blog/${post.slug}`} class="blog-card">
              {post.imagen_url && (
                <div class="blog-card__imagen">
                  <img
                    src={post.imagen_url}
                    alt={post.titulo}
                    width="600"
                    height="340"
                    loading="lazy"
                  />
                </div>
              )}
              <div class="blog-card__cuerpo">
                <div class="blog-card__meta">
                  {post.fecha_publicacion && (
                    <time datetime={post.fecha_publicacion}>{formatFecha(post.fecha_publicacion)}</time>
                  )}
                  {post.categoria && post.categoria !== 'general' && (
                    <span class="blog-card__cat">{post.categoria}</span>
                  )}
                </div>
                <h2 class="blog-card__titulo">{post.titulo}</h2>
                <p class="blog-card__extracto">{post.extracto}</p>
                <span class="blog-card__leer">Leer más →</span>
              </div>
            </a>
          ))}
        </div>
      ) : (
        <div class="blog-vacio">
          <p>Todavía no hay publicaciones. ¡Volvé pronto!</p>
        </div>
      )}
    </div>
  </section>

  <section class="franja">
    <div class="contenedor franja__fila">
      <div>
        <h2>¿Tenés algo para compartir?</h2>
        <p>Si querés contarnos una novedad o proponer una nota para el blog, escribinos.</p>
      </div>
      <a class="boton boton--azul" href="/contacto">Contactanos</a>
    </div>
  </section>
</Layout>

<style>
  .blog-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr));
    gap: 2rem;
  }

  .blog-card {
    display: flex;
    flex-direction: column;
    background: var(--papel);
    border: 1px solid var(--linea);
    border-radius: var(--radio);
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: box-shadow 0.25s ease, transform 0.25s ease;
  }
  .blog-card:hover {
    box-shadow: 0 8px 28px rgba(0,0,0,0.09);
    transform: translateY(-3px);
  }

  .blog-card__imagen {
    aspect-ratio: 16/9;
    overflow: hidden;
  }
  .blog-card__imagen img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.35s ease;
  }
  .blog-card:hover .blog-card__imagen img {
    transform: scale(1.04);
  }

  .blog-card__cuerpo {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .blog-card__meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.8125rem;
    color: var(--gris);
    margin-bottom: 0.625rem;
  }
  .blog-card__cat {
    background: var(--base2);
    padding: 0.15em 0.55em;
    border-radius: 3px;
    font-size: 0.75rem;
    text-transform: capitalize;
  }

  .blog-card__titulo {
    font-family: var(--display);
    font-size: clamp(1.15rem, 2.5vw, 1.35rem);
    line-height: 1.3;
    margin: 0 0 0.5rem;
    color: var(--tinta);
  }

  .blog-card__extracto {
    color: var(--gris-cuerpo);
    font-size: 0.9375rem;
    line-height: 1.6;
    margin: 0 0 1rem;
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .blog-card__leer {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--lapis-claro);
    transition: color 0.2s ease;
  }
  .blog-card:hover .blog-card__leer {
    color: var(--oro-texto);
  }

  .blog-vacio {
    text-align: center;
    padding: 4rem 1rem;
    color: var(--gris);
    font-size: 1.125rem;
  }
</style>

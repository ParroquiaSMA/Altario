---
import Layout from '../layouts/Layout.astro';
import { getSiteConfig, getGaleria } from '../lib/supabase';

const siteConfig = await getSiteConfig();
const { parroquia } = siteConfig;
const fotos = await getGaleria();
---

<Layout title={`Galería — ${parroquia.nombre}`} currentPage="galeria">
  <section class="portada">
    <svg class="portada__fondo" viewBox="0 0 1200 300" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
      <g fill="none" stroke="#C9A96A">
        <circle cx="980" cy="150" r="60"></circle><circle cx="980" cy="150" r="110"></circle>
        <circle cx="980" cy="150" r="160"></circle><circle cx="980" cy="150" r="215"></circle>
        <path d="M980 -70 V370 M760 150 H1200"></path>
        <path d="M825 -5 L1135 305 M1135 -5 L825 305"></path>
        <path d="M200 300 V170 a60 60 0 0 1 120 0 V300"></path>
      </g>
    </svg>
    <div class="contenedor">
      <p class="miga"><a href="/">Inicio</a><span aria-hidden="true">›</span>Galería</p>
      <p class="antetitulo">Galería</p>
      <h1>La parroquia por dentro</h1>
      <p class="portada__bajada">
        Tocá cualquier foto para verla en grande. Con el teclado, movete con las flechas y salí con Escape.
      </p>
    </div>
  </section>

  <section class="seccion">
    <div class="contenedor">
      <div class="filtros" role="group" aria-label="Filtrar fotos por tema">
        <button class="filtro" type="button" data-filtro="todas" aria-pressed="true">Todas</button>
        <button class="filtro" type="button" data-filtro="templo" aria-pressed="false">El templo</button>
        <button class="filtro" type="button" data-filtro="celebraciones" aria-pressed="false">Celebraciones</button>
        <button class="filtro" type="button" data-filtro="comunidad" aria-pressed="false">Comunidad</button>
      </div>

      <p id="galeria-conteo" aria-live="polite" style="color:var(--gris);font-size:1rem">{fotos.length} fotos</p>

      {fotos.length === 0 ? (
        <div style="text-align: center; padding: 4rem 1rem; color: var(--gris);">
          <p style="font-size: 1.1rem; font-weight: 500;">No hay fotografías publicadas en la galería por el momento.</p>
        </div>
      ) : (
        <ul class="galeria" id="galeria">
          {fotos.map((foto) => (
            <li data-categoria={foto.categoria || 'templo'}>
              <figure class="foto">
                <button class="foto__btn" type="button" aria-label={`Ver en grande: ${foto.titulo}`}>
                  <img
                    src={foto.imagen_url}
                    data-grande={foto.imagen_url}
                    alt={foto.descripcion || foto.titulo}
                    loading="lazy"
                  />
                </button>
                <figcaption>{foto.titulo}</figcaption>
              </figure>
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>

  <!-- Visor a pantalla completa -->
  <dialog class="visor" id="visor" aria-label="Foto ampliada">
    <div class="visor__marco">
      <img id="visor-img" src="" alt="" />
    </div>
    <div class="visor__pie">
      <p class="visor__texto"><span id="visor-texto"></span> · <span id="visor-posicion"></span></p>
      <div class="visor__controles">
        <button type="button" id="visor-anterior">← Anterior</button>
        <button type="button" id="visor-siguiente">Siguiente →</button>
        <button type="button" id="visor-cerrar">Cerrar</button>
      </div>
    </div>
  </dialog>

  <section class="franja">
    <div class="contenedor franja__fila">
      <div>
        <h2>¿Sacaste fotos en una celebración?</h2>
        <p>Mandanos las que te gusten y las sumamos a la galería, siempre con permiso de quienes aparecen.</p>
      </div>
      <a class="boton boton--azul" href="/contacto">Mandar fotos</a>
    </div>
  </section>

  <script>
    function initGaleria() {
      const filtros = document.querySelectorAll<HTMLButtonElement>('.filtros [data-filtro]');
      const fotosLi = document.querySelectorAll<HTMLLIElement>('.galeria > li');
      const conteoEl = document.getElementById('galeria-conteo');
      const visor = document.getElementById('visor') as HTMLDialogElement | null;
      const visorImg = document.getElementById('visor-img') as HTMLImageElement | null;
      const visorTexto = document.getElementById('visor-texto');
      const visorPosicion = document.getElementById('visor-posicion');
      const visorAnt = document.getElementById('visor-anterior');
      const visorSig = document.getElementById('visor-siguiente');
      const visorCerrar = document.getElementById('visor-cerrar');

      let currentVisibleFotos: { btn: HTMLButtonElement; img: HTMLImageElement; title: string }[] = [];
      let currentIndex = 0;

      function updateVisibleList() {
        currentVisibleFotos = [];
        fotosLi.forEach((li) => {
          if (!li.hidden) {
            const btn = li.querySelector<HTMLButtonElement>('.foto__btn');
            const img = li.querySelector<HTMLImageElement>('.foto__btn img');
            const cap = li.querySelector('figcaption');
            if (btn && img) {
              currentVisibleFotos.push({
                btn,
                img,
                title: cap?.textContent?.trim() || img.alt || 'Fotografía',
              });
            }
          }
        });

        if (conteoEl) {
          const total = currentVisibleFotos.length;
          conteoEl.textContent = `${total} foto${total === 1 ? '' : 's'}`;
        }
      }

      // 1. Filtrado interactivo
      filtros.forEach((b) => {
        b.addEventListener('click', () => {
          filtros.forEach((otro) => {
            otro.classList.remove('activo');
            otro.setAttribute('aria-pressed', 'false');
          });
          b.classList.add('activo');
          b.setAttribute('aria-pressed', 'true');

          const f = b.getAttribute('data-filtro');
          fotosLi.forEach((li) => {
            const cat = li.getAttribute('data-categoria');
            const coincide = f === 'todas' || cat === f;
            li.hidden = !coincide;
          });

          updateVisibleList();
        });
      });

      // 2. Visor / Zoom modal
      function showPhoto(index: number) {
        if (!visor || !visorImg || currentVisibleFotos.length === 0) return;
        if (index < 0) index = currentVisibleFotos.length - 1;
        if (index >= currentVisibleFotos.length) index = 0;
        currentIndex = index;

        const current = currentVisibleFotos[currentIndex];
        const srcGrande = current.img.getAttribute('data-grande') || current.img.src;
        visorImg.src = srcGrande;
        visorImg.alt = current.title;
        if (visorTexto) visorTexto.textContent = current.title;
        if (visorPosicion) visorPosicion.textContent = `${currentIndex + 1} de ${currentVisibleFotos.length}`;
      }

      fotosLi.forEach((li) => {
        const btn = li.querySelector<HTMLButtonElement>('.foto__btn');
        if (btn) {
          btn.addEventListener('click', () => {
            updateVisibleList();
            const img = btn.querySelector<HTMLImageElement>('img');
            const foundIdx = currentVisibleFotos.findIndex((item) => item.img === img);
            if (foundIdx !== -1) {
              showPhoto(foundIdx);
              if (visor && !visor.open) visor.showModal();
            }
          });
        }
      });

      if (visorAnt) {
        visorAnt.addEventListener('click', (e) => {
          e.stopPropagation();
          showPhoto(currentIndex - 1);
        });
      }

      if (visorSig) {
        visorSig.addEventListener('click', (e) => {
          e.stopPropagation();
          showPhoto(currentIndex + 1);
        });
      }

      if (visorCerrar) {
        visorCerrar.addEventListener('click', () => {
          visor?.close();
        });
      }

      // Cerrar al hacer clic en el backdrop fuera de la imagen/controles
      if (visor) {
        visor.addEventListener('click', (e) => {
          if (e.target === visor) {
            visor.close();
          }
        });
      }

      // Atajos de teclado
      document.addEventListener('keydown', (e) => {
        if (!visor || !visor.open) return;
        if (e.key === 'ArrowLeft') {
          e.preventDefault();
          showPhoto(currentIndex - 1);
        } else if (e.key === 'ArrowRight') {
          e.preventDefault();
          showPhoto(currentIndex + 1);
        }
      });

      updateVisibleList();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initGaleria);
    } else {
      initGaleria();
    }
  </script>
</Layout>

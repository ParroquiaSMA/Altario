<script>
  function setupMuseoScroll() {
    const galeria = document.getElementById('galeria-tesoros');
    const prevBtn = document.getElementById('btn-museo-prev');
    const nextBtn = document.getElementById('btn-museo-next');

    if (galeria && prevBtn && nextBtn) {
      prevBtn.addEventListener('click', () => {
        galeria.scrollBy({ left: -340, behavior: 'smooth' });
      });
      nextBtn.addEventListener('click', () => {
        galeria.scrollBy({ left: 340, behavior: 'smooth' });
      });
    }
  }

  function setupTablaScroll() {
    const scrollArea = document.querySelector('.tabla-scroll-area');
    if (scrollArea instanceof HTMLElement) {
      let isDown = false;
      let startX = 0;
      let scrollLeft = 0;

      scrollArea.addEventListener('mousedown', (e) => {
        isDown = true;
        scrollArea.style.cursor = 'grabbing';
        startX = e.pageX - scrollArea.offsetLeft;
        scrollLeft = scrollArea.scrollLeft;
      });

      window.addEventListener('mouseup', () => {
        if (!isDown) return;
        isDown = false;
        if (scrollArea) scrollArea.style.cursor = 'grab';
      });

      scrollArea.addEventListener('mousemove', (e) => {
        if (!isDown) return;
        e.preventDefault();
        const x = e.pageX - scrollArea.offsetLeft;
        const walk = (x - startX) * 1.5;
        scrollArea.scrollLeft = scrollLeft - walk;
      });
    }
  }

  setupMuseoScroll();
  setupTablaScroll();
  document.addEventListener('astro:page-load', () => {
    setupMuseoScroll();
    setupTablaScroll();
  });
</script>

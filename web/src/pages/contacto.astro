---
import Layout from '../layouts/Layout.astro';
import { getSiteConfig } from '../lib/supabase';

const siteConfig = await getSiteConfig();
const { parroquia, contacto, parroco, redes, donaciones } = siteConfig;
const mpActivo = donaciones?.mercadopago?.activo ?? true;
const mpPublicKey = donaciones?.mercadopago?.public_key || import.meta.env.PUBLIC_MERCADO_PAGO_KEY || 'APP_USR-3e91a063-54aa-4430-b99f-f0b2f36027ef';
---

<Layout title={`Contacto — ${parroquia.nombre}`} currentPage="contacto">
  <section class="portada">
    <svg class="portada__fondo" viewBox="0 0 1200 300" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
      <g fill="none" stroke="#C9A96A">
        <circle cx="980" cy="150" r="60"></circle><circle cx="980" cy="150" r="110"></circle>
        <circle cx="980" cy="150" r="160"></circle><circle cx="980" cy="150" r="215"></circle>
        <path d="M980 -70 V370 M760 150 H1200"></path>
        <path d="M825 -5 L1135 305 M1135 -5 L825 305"></path>
        <path d="M200 300 V170 a60 60 0 0 1 120 0 V300"></path>
      </g>
    </svg>
    <div class="contenedor">
      <p class="miga"><a href="/">Inicio</a><span aria-hidden="true">›</span>Contacto</p>
      <p class="antetitulo">Contacto</p>
      <h1>Escribinos, llamanos o pasá por la secretaría</h1>
      <p class="portada__bajada">
        Contestamos los mensajes de lunes a viernes. Para una urgencia con un enfermo, mejor llamá por teléfono
        a cualquier hora.
      </p>
    </div>
  </section>

  <section class="seccion">
    <div class="contenedor">
      <div class="contacto">
        <div>
          <h2>Datos de la parroquia</h2>
          <p class="divisor"><i aria-hidden="true"></i></p>

          <ul class="datos">
            <li><strong>Dirección</strong> <span>{contacto.direccion}</span></li>
            {contacto.telefono && (
              <li><strong>Teléfono</strong> <span><a href={`tel:${contacto.telefono.replace(/[^0-9+]/g, '')}`}>{contacto.telefono}</a></span></li>
            )}
            {contacto.whatsapp && (
              <li><strong>WhatsApp</strong> <span><a href={contacto.whatsapp.startsWith('http') ? contacto.whatsapp : `https://wa.me/${contacto.whatsapp.replace(/[^0-9]/g, '')}`} target="_blank">{contacto.whatsapp}</a></span></li>
            )}
            {contacto.email && (
              <li><strong>Correo</strong> <span><a href={`mailto:${contacto.email}`}>{contacto.email}</a></span></li>
            )}
            {parroco.nombre && (
              <li><strong>Párroco</strong> <span>{parroco.nombre} {parroco.titulo ? `(${parroco.titulo})` : ''}</span></li>
            )}
            {contacto.horario_secretaria && (
              <li><strong>Secretaría</strong> <span>{contacto.horario_secretaria}</span></li>
            )}
          </ul>

          <h3 style="margin-bottom:.75rem">Seguinos en redes</h3>
          <ul class="redes">
            {redes.facebook && (
              <li><a href={redes.facebook} rel="me noopener" target="_blank">
                <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path d="M13.7 21v-8h2.7l.4-3.1h-3.1V7.9c0-.9.3-1.5 1.6-1.5h1.6V3.6c-.3 0-1.3-.1-2.4-.1-2.4 0-4 1.5-4 4.1v2.3H7.8V13h2.7v8h3.2z"/></svg>
                Facebook</a></li>
            )}
            {redes.instagram && (
              <li><a href={redes.instagram} rel="me noopener" target="_blank">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3.2" y="3.2" width="17.6" height="17.6" rx="5"/><circle cx="12" cy="12" r="4.1"/><circle cx="17.1" cy="6.9" r="1.1" fill="currentColor" stroke="none"/></svg>
                Instagram</a></li>
            )}
            {redes.youtube && (
              <li><a href={redes.youtube} rel="me noopener" target="_blank">
                <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path d="M22 12s0-3.3-.4-4.9a2.6 2.6 0 0 0-1.8-1.8C18.2 4.9 12 4.9 12 4.9s-6.2 0-7.8.4a2.6 2.6 0 0 0-1.8 1.8C2 8.7 2 12 2 12s0 3.3.4 4.9a2.6 2.6 0 0 0 1.8 1.8c1.6.4 7.8.4 7.8.4s6.2 0 7.8-.4a2.6 2.6 0 0 0 1.8-1.8c.4-1.6.4-4.9.4-4.9zM10 15.2V8.8l5.5 3.2-5.5 3.2z"/></svg>
                YouTube</a></li>
            )}
            {redes.whatsapp && (
              <li><a href={redes.whatsapp.startsWith('http') ? redes.whatsapp : `https://wa.me/${redes.whatsapp.replace(/[^0-9]/g, '')}`} rel="me noopener" target="_blank">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true"><path d="M12 2.6a9.4 9.4 0 0 0-8 14.3L2.6 21.4l4.7-1.3A9.4 9.4 0 1 0 12 2.6z"/><path d="M9.1 8c.3 0 .5.1.7.5l.7 1.4c.1.3 0 .5-.2.7l-.5.5c-.2.2-.2.4-.1.6.5.9 1.3 1.7 2.2 2.2.2.1.4.1.6-.1l.5-.5c.2-.2.4-.3.7-.2l1.4.7c.4.2.5.4.5.7 0 .8-.7 1.5-1.5 1.5-3 0-6-3-6-6C7.6 8.7 8.3 8 9.1 8z" stroke-linecap="round"/></svg>
                WhatsApp</a></li>
            )}
          </ul>

          <div class="ficha" style="margin-top:2rem">
            <h3>Cómo llegar</h3>
            <p>{contacto.como_llegar || 'Líneas de transporte público sobre la avenida principal.'}</p>
            <p style="margin-bottom:0"><strong>Accesibilidad:</strong> rampa por la puerta lateral, baño accesible en el salón y lugares reservados para sillas de ruedas en la nave central.</p>
          </div>

          {donaciones && ((donaciones.cuentas_bancarias && donaciones.cuentas_bancarias.length > 0) || (donaciones.medios_donacion && donaciones.medios_donacion.length > 0)) && (
            <div class="ficha" id="colaborar" style="margin-top:2rem">
              <h3>{donaciones.titulo_seccion || 'Colaborar con la parroquia'}</h3>
              <p>{donaciones.mensaje || 'Tu aporte sostiene el templo, las actividades y la ayuda social a las familias de la comunidad.'}</p>
              <p style="margin-top:1.25rem;margin-bottom:0">
                <button type="button" class="boton boton--azul" id="btn-abrir-donar">
                  Donar en línea o ver cuentas
                </button>
              </p>
            </div>
          )}
        </div>

        <div>
          <h2>Mandanos un mensaje</h2>
          <p class="divisor"><i aria-hidden="true"></i></p>

          <div class="aviso-form" id="form-ok" hidden role="status">
            <strong>Mensaje enviado.</strong> Te respondemos dentro de los próximos dos días hábiles.
          </div>

          <form class="formulario" id="form-contacto" novalidate>
            <div class="campo">
              <label for="nombre">Tu nombre <span class="requerido" aria-hidden="true">*</span></label>
              <input type="text" id="nombre" name="nombre" required autocomplete="name" aria-describedby="error-nombre" />
              <span class="error" id="error-nombre" role="alert"></span>
            </div>

            <div class="campo">
              <label for="correo">Correo electrónico <span class="requerido" aria-hidden="true">*</span></label>
              <span class="ayuda" id="ayuda-correo">Lo usamos solamente para responderte.</span>
              <input type="email" id="correo" name="correo" required autocomplete="email" aria-describedby="ayuda-correo error-correo" />
              <span class="error" id="error-correo" role="alert"></span>
            </div>

            <div class="campo">
              <label for="telefono">Teléfono</label>
              <span class="ayuda" id="ayuda-telefono">Opcional. Si preferís que te llamemos, dejalo.</span>
              <input type="tel" id="telefono" name="telefono" autocomplete="tel" aria-describedby="ayuda-telefono" />
            </div>

            <div class="campo">
              <label for="motivo">¿De qué se trata? <span class="requerido" aria-hidden="true">*</span></label>
              <select id="motivo" name="motivo" required aria-describedby="error-motivo">
                <option value="">Elegí una opción</option>
                <option>Bautismo</option>
                <option>Primera comunión o confirmación</option>
                <option>Matrimonio</option>
                <option>Visita a un enfermo</option>
                <option>Exequias o misa de aniversario</option>
                <option>Sumarme a un grupo</option>
                <option>Colaborar o donar</option>
                <option>Certificados y partidas</option>
                <option>Otra cosa</option>
              </select>
              <span class="error" id="error-motivo" role="alert"></span>
            </div>

            <div class="campo">
              <label for="mensaje">Tu mensaje <span class="requerido" aria-hidden="true">*</span></label>
              <span class="ayuda" id="ayuda-mensaje">Contanos con tus palabras. Si es un trámite, sumá las fechas que tenés en mente.</span>
              <textarea id="mensaje" name="mensaje" required minlength="15" aria-describedby="ayuda-mensaje error-mensaje"></textarea>
              <span class="error" id="error-mensaje" role="alert"></span>
            </div>

            <fieldset>
              <legend>¿Cómo preferís que te respondamos?</legend>
              <div class="opciones">
                <label class="opcion"><input type="radio" name="respuesta" value="correo" checked /> Por correo electrónico</label>
                <label class="opcion"><input type="radio" name="respuesta" value="telefono" /> Por teléfono o WhatsApp</label>
                <label class="opcion"><input type="radio" name="respuesta" value="presencial" /> Prefiero pasar por la secretaría</label>
              </div>
            </fieldset>

            <p style="font-size:.9375rem;color:var(--gris)">
              Los campos con <span class="requerido" aria-hidden="true">*</span><span class="vo">asterisco</span> son obligatorios.
              Usamos tus datos solo para responderte y no los compartimos con nadie.
            </p>

            <button class="boton boton--azul" type="submit">Enviar mensaje</button>
          </form>
        </div>
      </div>
    </div>
  </section>

  <dialog id="modal-donar" class="modal-donar" aria-labelledby="modal-donar-titulo" data-mp-public-key={mpPublicKey} data-mp-activo={mpActivo ? "true" : "false"}>
    <div class="modal-donar__cabecera">
      <div>
        <h2 id="modal-donar-titulo">{donaciones?.titulo_seccion || 'Colaborar con la parroquia'}</h2>
        <p>{donaciones?.mensaje || 'Tu aporte sostiene las actividades parroquiales, el templo y la ayuda social.'}</p>
      </div>
      <button type="button" class="modal-donar__cerrar" id="btn-cerrar-donar" aria-label="Cerrar ventana">×</button>
    </div>

    <div class="modal-donar__cuerpo">
      <!-- Vista Principal: Formulario de Donación con Mercado Pago -->
      <div id="mp-vista-formulario">
        {mpActivo ? (
          <>
            <!-- Selector de Frecuencia -->
            <div class="modal-donar__frecuencia" role="tablist" aria-label="Frecuencia de la donación">
              <button type="button" class="frecuencia-btn activo" id="btn-frecuencia-unica" data-frecuencia="unica">
                Por única vez
              </button>
              <button type="button" class="frecuencia-btn" id="btn-frecuencia-mensual" data-frecuencia="mensual">
                Aporte mensual
              </button>
            </div>

            <!-- Selector de Montos -->
            <div class="modal-donar__montos">
              <label class="modal-donar__label" id="label-monto">Seleccioná un monto en Pesos Uruguayos:</label>
              <div class="montos-grid" role="group" aria-labelledby="label-monto">
                <button type="button" class="monto-chip" data-monto="200">$ 200</button>
                <button type="button" class="monto-chip activo" data-monto="500">$ 500</button>
                <button type="button" class="monto-chip" data-monto="1000">$ 1.000</button>
                <button type="button" class="monto-chip" data-monto="2000">$ 2.000</button>
              </div>
              <div class="monto-custom-wrap">
                <span class="monto-custom-moneda" aria-hidden="true">$</span>
                <input type="number" id="input-monto-custom" class="monto-custom-input" placeholder="Otro monto (ej. 300, 1500)" min="50" step="50" aria-label="Otro monto personalizado" />
                <span class="monto-custom-tag" aria-hidden="true">UYU</span>
              </div>
            </div>

            <!-- Mensaje de ayuda contextual -->
            <div id="mp-info-frecuencia" class="modal-donar__info-frecuencia">
              <span>✨ Donación puntual con tarjeta de crédito, débito o redes Abitab / Redpagos.</span>
            </div>

            <!-- Alerta de Error si ocurre -->
            <div id="mp-error-alerta" class="mp-alerta-error" style="display:none" role="alert"></div>

            <!-- Contenedor del Payment Brick de Mercado Pago -->
            <div class="mp-brick-container-wrap">
              <div id="mp-brick-loading" class="mp-loading-skeleton">
                <div class="mp-spinner" aria-hidden="true"></div>
                <p>Cargando medios de pago seguros de Mercado Pago...</p>
              </div>
              <div id="paymentBrick_container"></div>
            </div>
          </>
        ) : (
          <div class="modal-donar__info-frecuencia" style="margin-bottom:1.5rem">
            <span>ℹ️ Las donaciones en línea con tarjeta están momentáneamente pausadas. Podés colaborar mediante transferencia bancaria o en las alcancías del templo.</span>
          </div>
        )}

        <!-- Acordeón para Transferencias Bancarias alternativas -->
        {donaciones && ((donaciones.cuentas_bancarias && donaciones.cuentas_bancarias.length > 0) || (donaciones.medios_donacion && donaciones.medios_donacion.length > 0)) && (
          <details class="modal-donar__alternativas" open={!mpActivo}>
            <summary><span>{mpActivo ? "Ver datos para transferencia bancaria tradicional u otros medios" : "Cuentas bancarias para transferencias"}</span></summary>
            <div class="modal-donar__alternativas-cuerpo">
              {donaciones.cuentas_bancarias && donaciones.cuentas_bancarias.length > 0 && (
                <div class="modal-donar__seccion" style="margin-bottom:1rem">
                  <h3 class="modal-donar__subtitulo">Cuentas bancarias</h3>
                  {donaciones.cuentas_bancarias.map((c) => (
                    <div class="modal-donar__cuenta">
                      <div class="modal-donar__cuenta-cabecera">
                        <span>{c.banco}</span>
                        <span class="modal-donar__cuenta-tipo">{c.tipo_cuenta}</span>
                      </div>
                      <ul class="datos">
                        <li><strong>N.º de cuenta</strong> <span>{c.numero_cuenta}</span></li>
                        {c.titular && <li><strong>Titular</strong> <span>{c.titular}</span></li>}
                        {c.identificacion_fiscal && <li><strong>RUT / Doc</strong> <span>{c.identificacion_fiscal}</span></li>}
                        {c.referencia && <li><strong>Referencia</strong> <span>{c.referencia}</span></li>}
                      </ul>
                    </div>
                  ))}
                </div>
              )}

              {donaciones.medios_donacion && donaciones.medios_donacion.length > 0 && (
                <div class="modal-donar__seccion">
                  <h3 class="modal-donar__subtitulo">Otras formas de colaborar</h3>
                  {donaciones.medios_donacion.map((m) => (
                    <div class="modal-donar__medio">
                      <h4>{m.titulo}</h4>
                      <p>{m.descripcion}</p>
                      {m.enlace && (
                        <p style="margin-top:.5rem">
                          <a class="boton boton--linea" href={m.enlace} target="_blank" rel="noopener">
                            {m.etiqueta_boton || 'Donar en línea'}
                          </a>
                        </p>
                      )}
                    </div>
                  ))}
                </div>
              )}
            </div>
          </details>
        )}
      </div>

      <!-- Vista de Éxito tras confirmación -->
      <div id="mp-vista-exito" class="mp-vista-exito" style="display:none">
        <div class="mp-exito-icono" aria-hidden="true">
          <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
            <polyline points="22 4 12 14.01 9 11.01"></polyline>
          </svg>
        </div>
        <h3 id="mp-exito-titulo">¡Muchas gracias por tu colaboración!</h3>
        <p id="mp-exito-mensaje">Tu generosidad sostiene las obras y la vida de nuestra comunidad parroquial.</p>

        <div class="mp-exito-detalle">
          <div class="mp-exito-fila">
            <span>Monto aportado:</span>
            <strong id="mp-exito-monto">$ 500 UYU</strong>
          </div>
          <div class="mp-exito-fila">
            <span>Modalidad:</span>
            <strong id="mp-exito-modalidad">Donación puntual</strong>
          </div>
          <div class="mp-exito-fila" id="mp-exito-id-wrap">
            <span>N.º de comprobante:</span>
            <strong id="mp-exito-id">#--</strong>
          </div>
        </div>

        <div id="mp-ticket-wrap" style="display:none; margin-top:1.25rem;">
          <a id="mp-ticket-link" href="#" target="_blank" rel="noopener" class="boton boton--azul" style="display:inline-block; text-decoration:none;">
            Ver cupón de pago para Abitab / Redpagos
          </a>
        </div>

        <div style="margin-top:1.5rem; text-align:center;">
          <button type="button" class="boton boton--linea" id="btn-finalizar-donar">
            Finalizar y cerrar
          </button>
        </div>
      </div>
    </div>

    <div class="modal-donar__pie">
      <div class="mp-seguridad-badge">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z"/></svg>
        <span>Pagos procesados de forma segura mediante <strong>Mercado Pago Uruguay</strong></span>
      </div>
    </div>
  </dialog>

  <!-- Script del SDK oficial de Mercado Pago -->
  <script is:inline src="https://sdk.mercadopago.com/js/v2"></script>

  <script is:inline>
    document.addEventListener("DOMContentLoaded", () => {
      const modal = document.getElementById("modal-donar");
      const btnAbrir = document.getElementById("btn-abrir-donar");
      const btnCerrar = document.getElementById("btn-cerrar-donar");
      const btnFinalizar = document.getElementById("btn-finalizar-donar");

      // Elementos del formulario y vistas
      const vistaFormulario = document.getElementById("mp-vista-formulario");
      const vistaExito = document.getElementById("mp-vista-exito");
      const btnFrecUnica = document.getElementById("btn-frecuencia-unica");
      const btnFrecMensual = document.getElementById("btn-frecuencia-mensual");
      const infoFrecuencia = document.getElementById("mp-info-frecuencia");
      const chipsMonto = document.querySelectorAll(".monto-chip");
      const inputMontoCustom = document.getElementById("input-monto-custom");
      const brickContainer = document.getElementById("paymentBrick_container");
      const brickLoading = document.getElementById("mp-brick-loading");
      const errorDiv = document.getElementById("mp-error-alerta");

      // Elementos de la vista de éxito
      const exitoMonto = document.getElementById("mp-exito-monto");
      const exitoModalidad = document.getElementById("mp-exito-modalidad");
      const exitoId = document.getElementById("mp-exito-id");
      const ticketWrap = document.getElementById("mp-ticket-wrap");
      const ticketLink = document.getElementById("mp-ticket-link");

      // Estado
      let mpInstance = null;
      let bricksBuilder = null;
      let brickController = null;
      let currentFrecuencia = "unica";
      let currentMonto = 500;
      let isRendering = false;

      const publicKey = modal?.getAttribute("data-mp-public-key") || "APP_USR-3e91a063-54aa-4430-b99f-f0b2f36027ef";

      const formatearMonto = (m) => `$ ${Number(m).toLocaleString('es-UY')} UYU`;

      const mostrarError = (msg) => {
        if (!errorDiv) return;
        errorDiv.textContent = msg;
        errorDiv.style.display = "block";
      };

      const ocultarError = () => {
        if (errorDiv) errorDiv.style.display = "none";
      };

      const renderBrick = async () => {
        if (!mpInstance || !bricksBuilder || isRendering) return;
        isRendering = true;
        ocultarError();

        if (brickLoading) brickLoading.style.display = "flex";

        try {
          if (brickController) {
            await brickController.unmount();
            brickController = null;
          }

          if (brickContainer) {
            brickContainer.innerHTML = "";
          }

          const isMonthly = currentFrecuencia === "mensual";

          const settings = {
            initialization: {
              amount: Number(currentMonto),
            },
            customization: {
              paymentMethods: isMonthly
                ? {
                    creditCard: "all",
                  }
                : {
                    creditCard: "all",
                    debitCard: "all",
                    ticket: "all",
                  },
              visual: {
                style: {
                  theme: "default",
                  customVariables: {
                    baseColor: "#16244A",
                    borderRadiusMedium: "10px",
                    inputVerticalPadding: "14px",
                    inputHorizontalPadding: "16px",
                    formPadding: "0px",
                  },
                },
                hideFormTitle: true,
                hideValue: true,
                texts: {
                  formSubmit: isMonthly ? "Confirmar aporte mensual" : "Confirmar donación",
                },
              },
            },
            callbacks: {
              onReady: () => {
                isRendering = false;
                if (brickLoading) brickLoading.style.display = "none";
              },
              onSubmit: ({ formData }) => {
                return new Promise((resolve, reject) => {
                  ocultarError();

                  const endpoint = isMonthly
                    ? "/api/donaciones/suscribir"
                    : "/api/donaciones/procesar-pago";

                  const payload = isMonthly
                    ? {
                        card_token_id: formData.token,
                        transaction_amount: Number(currentMonto),
                        payer_email: formData.payer?.email || "donante@parroquiasma.uy",
                        reason: "Sostenimiento mensual Parroquia Santa María de la Ayuda",
                      }
                    : {
                        ...formData,
                        transaction_amount: Number(currentMonto),
                        description: "Donación Parroquia Santa María de la Ayuda",
                      };

                  fetch(endpoint, {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify(payload),
                  })
                    .then(async (res) => {
                      const data = await res.json();
                      if (data.status === "approved" || data.status === "authorized" || data.status === "pending") {
                        mostrarExito(data, isMonthly, currentMonto);
                        resolve();
                      } else {
                        const msg =
                          data.message ||
                          (data.cause && data.cause[0]?.description) ||
                          "La transacción no pudo ser autorizada. Verifica los datos e intenta nuevamente.";
                        mostrarError(msg);
                        reject();
                      }
                    })
                    .catch((err) => {
                      console.error("Error al procesar donación:", err);
                      mostrarError("Error de conexión al procesar el pago. Por favor intenta de nuevo.");
                      reject();
                    });
                });
              },
              onError: (err) => {
                console.error("Error en Mercado Pago Brick:", err);
                isRendering = false;
                if (brickLoading) brickLoading.style.display = "none";
              },
            },
          };

          brickController = await bricksBuilder.create("payment", "paymentBrick_container", settings);
        } catch (err) {
          console.error("Error al montar Payment Brick:", err);
          isRendering = false;
          if (brickLoading) brickLoading.style.display = "none";
        }
      };

      const mostrarExito = (data, isMonthly, monto) => {
        if (vistaFormulario) vistaFormulario.style.display = "none";
        if (vistaExito) vistaExito.style.display = "block";

        if (exitoMonto) exitoMonto.textContent = formatearMonto(monto);
        if (exitoModalidad) {
          exitoModalidad.textContent = isMonthly
            ? "Aporte mensual recurrente (débito automático)"
            : "Donación puntual";
        }
        if (exitoId) exitoId.textContent = `#${data.id || Date.now()}`;

        // Ticket en efectivo (Abitab / Redpagos)
        const ticketUrl = data.ticket_url || (data.transaction_details && data.transaction_details.external_resource_url);
        if (ticketUrl && ticketWrap && ticketLink) {
          ticketLink.href = ticketUrl;
          ticketWrap.style.display = "block";
        } else if (ticketWrap) {
          ticketWrap.style.display = "none";
        }
      };

      const initMercadoPago = async () => {
        const isActivo = modal?.getAttribute("data-mp-activo") !== "false";
        if (!isActivo) return;

        if (!window.MercadoPago) {
          console.warn("Mercado Pago SDK no disponible.");
          return;
        }

        if (!mpInstance) {
          mpInstance = new window.MercadoPago(publicKey, { locale: "es-UY" });
          bricksBuilder = mpInstance.bricks();
        }

        await renderBrick();
      };

      // Control de Apertura y Cierre
      if (btnAbrir && modal) {
        btnAbrir.addEventListener("click", () => {
          modal.showModal();
          initMercadoPago();
        });
      }

      const resetearModal = () => {
        if (vistaFormulario) vistaFormulario.style.display = "block";
        if (vistaExito) vistaExito.style.display = "none";
        ocultarError();
      };

      const cerrarModal = () => {
        if (modal) modal.close();
        resetearModal();
      };

      if (btnCerrar) btnCerrar.addEventListener("click", cerrarModal);
      if (btnFinalizar) btnFinalizar.addEventListener("click", cerrarModal);

      if (modal) {
        modal.addEventListener("click", (e) => {
          const rect = modal.getBoundingClientRect();
          const isInDialog =
            rect.top <= e.clientY &&
            e.clientY <= rect.top + rect.height &&
            rect.left <= e.clientX &&
            e.clientX <= rect.left + rect.width;
          if (!isInDialog) {
            cerrarModal();
          }
        });
      }

      // Cambio de Frecuencia
      if (btnFrecUnica && btnFrecMensual) {
        btnFrecUnica.addEventListener("click", () => {
          if (currentFrecuencia === "unica") return;
          currentFrecuencia = "unica";
          btnFrecUnica.classList.add("activo");
          btnFrecMensual.classList.remove("activo");
          if (infoFrecuencia) {
            infoFrecuencia.innerHTML = "<span>✨ Donación puntual con tarjeta de crédito, débito o redes Abitab / Redpagos.</span>";
          }
          renderBrick();
        });

        btnFrecMensual.addEventListener("click", () => {
          if (currentFrecuencia === "mensual") return;
          currentFrecuencia = "mensual";
          btnFrecMensual.classList.add("activo");
          btnFrecUnica.classList.remove("activo");
          if (infoFrecuencia) {
            infoFrecuencia.innerHTML = "<span>🔄 Débito automático mensual con tarjeta de crédito. Podrás cancelarlo en cualquier momento.</span>";
          }
          renderBrick();
        });
      }

      // Chips de Montos
      chipsMonto.forEach((chip) => {
        chip.addEventListener("click", () => {
          chipsMonto.forEach((c) => c.classList.remove("activo"));
          chip.classList.add("activo");
          if (inputMontoCustom) inputMontoCustom.value = "";
          currentMonto = Number(chip.getAttribute("data-monto"));
          renderBrick();
        });
      });

      // Monto personalizado
      let customTimeout = null;
      if (inputMontoCustom) {
        inputMontoCustom.addEventListener("input", (e) => {
          const val = Number(e.target.value);
          if (val >= 50) {
            chipsMonto.forEach((c) => c.classList.remove("activo"));
            clearTimeout(customTimeout);
            customTimeout = setTimeout(() => {
              currentMonto = val;
              renderBrick();
            }, 600);
          }
        });
      }

      // Hash #colaborar
      if (window.location.hash === "#colaborar" && modal) {
        setTimeout(() => {
          modal.showModal();
          initMercadoPago();
        }, 300);
      }
    });
  </script>
</Layout>
